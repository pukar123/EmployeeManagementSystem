# Copy to `.env` next to docker-compose.yml (never commit `.env`).
# Treat any secret ever committed to git as compromised — rotate before use.

# SQL Server (shared by EMSDevDB + UserManagementDb)
SQL_SA_PASSWORD=change-me-use-a-strong-password

# MongoDB + Redis
MONGO_ROOT_PASSWORD=change-me-use-a-strong-password
REDIS_PASSWORD=change-me-use-a-strong-password

# EMS ↔ User Management service-client (must match on both sides)
EMS_UM_SERVICE_CLIENT_SECRET=change-me-use-a-long-random-secret

# JWT signing — generate locally; never commit private keys
# dotnet run --project Pukar.Usermanagement/tools/GenRsaKey -- ./secrets/dev-rsa-key.pem
JWT_SIGNING_KEY_PEM_FILE=dev-rsa-key.pem

# Browser-reachable URLs embedded at ems-web **build** time
NEXT_PUBLIC_EMS_API_BASE_URL=http://localhost:5246
NEXT_PUBLIC_USER_MANAGEMENT_API_BASE_URL=http://localhost:5137

# EMS CORS (browser origin for ems-web)
EMS_CORS_ORIGIN_0=http://localhost:3000
EMS_CORS_ORIGIN_1=http://127.0.0.1:3000

# UM CORS
UM_CORS_ORIGIN_0=http://localhost:3000
UM_CORS_ORIGIN_1=http://127.0.0.1:3000
