{
  "name": "ems-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build:um": "dotnet build ../Pukar.Usermanagement/Pukar.Usermanagement.Host/Pukar.Usermanagement.Host.csproj --no-restore --disable-build-servers -m:1",
    "build:api": "dotnet build ../EMS.API/EMS.API.csproj --no-restore --disable-build-servers -m:1",
    "build:dotnet": "npm run build:um && npm run build:api",
    "dev:all": "npm run build:dotnet && concurrently -n um,api,web -c yellow,cyan,magenta \"dotnet run --no-build --project ../Pukar.Usermanagement/Pukar.Usermanagement.Host/Pukar.Usermanagement.Host.csproj --launch-profile http\" \"dotnet run --no-build --project ../EMS.API/EMS.API.csproj --launch-profile http\" \"next dev\"",
    "dev:api": "dotnet run --project ../EMS.API/EMS.API.csproj --launch-profile http",
    "dev:um": "dotnet run --project ../Pukar.Usermanagement/Pukar.Usermanagement.Host/Pukar.Usermanagement.Host.csproj --launch-profile http",
    "dev:https": "concurrently -n um,api,web -c yellow,cyan,magenta \"dotnet run --project ../Pukar.Usermanagement/Pukar.Usermanagement.Host/Pukar.Usermanagement.Host.csproj --launch-profile https\" \"dotnet run --project ../EMS.API/EMS.API.csproj --launch-profile https\" \"next dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-query-devtools": "^5.96.2",
    "axios": "^1.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-big-calendar": "^1.19.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
