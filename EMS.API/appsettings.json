{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Enrichers.Environment" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ],
    "Properties": {
      "Application": "EMS.API",
      "Module": "EMS.API"
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=EMSDevDB;User Id=sa;TrustServerCertificate=True",
    "UserManagementDb": "Server=localhost,1433;Database=UserManagementDb;User Id=sa;TrustServerCertificate=True",
    "MongoDb": "mongodb://localhost:27017/?authSource=admin",
    "MongoLogs": "mongodb://localhost:27017/ems-logs?authSource=admin",
    "Redis": "localhost:6379"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "http://127.0.0.1:3000",
      "https://127.0.0.1:3000"
    ]
  },
  "Authorization": {
    "UseRoleKeyMapping": true,
    "EnableLegacyRoleIdFallback": false
  },
  "Jwt": {
    "Issuer": "Pukar.Usermanagement",
    "Audience": "ems",
    "SigningKeyId": "um-key-1",
    "SigningKey": "",
    "SigningKeyPem": "",
    "SigningKeyPemFile": "",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "ServiceTokenExpirationMinutes": 5
  },
  "PasswordPolicy": {
    "MinimumLength": 12,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireNonAlphanumeric": true
  },
  "PasswordReset": {
    "TokenExpirationMinutes": 30,
    "RequestCooldownSeconds": 60
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "SenderEmail": "noreply@localhost",
    "SenderName": "User Management",
    "WebAppBaseUrl": "http://localhost:3000"
  },
  "ServiceClients": {
    "Ems": {
      "ClientId": "ems",
      "Secret": "",
      "Name": "EMS.API"
    }
  },
  "SeedAdmin": {
    "Enabled": false,
    "ResetExistingPassword": false,
    "Email": "admin@localhost",
    "Password": ""
  },
  "EmployeeScheduling": {
    "BusinessTimeZoneId": "Australia/Sydney",
    "WorkerPollIntervalSeconds": 60
  },
  "AllowedHosts": "*"
}
